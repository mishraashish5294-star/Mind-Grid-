# MindGrid environment variables.
# Copy this file to `.env` for local development and never commit `.env`.
# In AppJet hosting, add these under Settings → Environment variables.

# Port the Express server listens on (AppJet supplies this automatically).
PORT=3000

# PostgreSQL connection string. Leave EMPTY to use the built-in JSON store,
# which keeps progress in ./data/mindgrid.json — fine for local development.
# Example: postgres://mindgrid:password@localhost:5432/mindgrid
DATABASE_URL=

# Set to "true" only when your PostgreSQL provider requires TLS
# (most hosted providers such as Supabase or Neon do).
PGSSL=false

# Optional directory for the JSON fallback (defaults to ./data).
DATA_DIR=
